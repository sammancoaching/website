#!/usr/bin/env bash
set -euo pipefail

# In some environments (e.g. remote dev containers) the gem bin directory
# is not on PATH, which makes `bundle exec jekyll` fail with "command not found".
export PATH="$(ruby -e 'print Gem.bindir'):$PATH"

bundle install
bundle exec jekyll build
ruby tests/ruby/calendar_events_test.rb
python -m pip install -r requirements.txt --quiet
mkdir -p junit-reports
python -m pytest tests/ --junit-xml=junit-reports/results.xml
